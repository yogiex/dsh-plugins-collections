{
  "name": "@local/dsh-bg-gradient",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Chat background for the DSH Web GUI: gradient, solid colour, procedural wallpaper, or your own image/GIF, with a Settings row.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
